# ------------------------------------------------------------------
# Copy to .env and fill in.  .env is gitignored.
# ------------------------------------------------------------------

# --- LLM (Groq) -----------------------------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# groq | local
LLM_PROVIDER=groq

# llama-3.3-70b-versatile | llama-3.1-8b-instant
# openai/gpt-oss-120b     | openai/gpt-oss-20b
GROQ_MODEL=llama-3.3-70b-versatile

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# --- Embeddings (run locally; Groq has no embedding API) ------------
# nomic-ai/nomic-embed-text-v1.5  -> 0.1B params,  768 dims  (default, lightest)
# BAAI/bge-m3                     -> 0.57B params, 1024 dims, multilingual
# Qwen/Qwen3-Embedding-0.6B       -> 0.6B params,  1024 dims
EMBED_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5

# auto | cpu | cuda
EMBED_DEVICE=auto
EMBED_BATCH_SIZE=16
EMBED_MAX_SEQ_LENGTH=1024

# Prefixes are auto-selected per model. Override only if you know you need to;
# set both to empty for symmetric models such as bge-m3 or qwen3.
# EMBED_DOC_PREFIX=
# EMBED_QUERY_PREFIX=

# --- Retrieval ------------------------------------------------------
RETRIEVAL_TOP_K=5
INGEST_MIN_CHARS=80
COLLECTION_PREFIX=site

# --- Service wiring -------------------------------------------------
SCRAPER_API_PORT=5005
CHAT_API_PORT=5003
SCRAPER_API_URL=http://localhost:5005
CHAT_API_URL=http://localhost:5003
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8502,http://127.0.0.1:8502

# --- Crawler --------------------------------------------------------
CRAWL_STRATEGY_DEFAULT=bfs
MAX_DEPTH_DEFAULT=3
MAX_TOTAL_PAGES_DEFAULT=200
MAX_TOTAL_NODES_DEFAULT=100
POLITE_DELAY_SEC=0.5
PAGE_TIMEOUT_MS=120000
